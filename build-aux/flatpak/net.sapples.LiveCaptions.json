{
    "app-id" : "net.sapples.LiveCaptions",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "livecaptions",
    "finish-args" : [
        "--share=ipc",
        "--device=dri",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--socket=fallback-x11"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "/onnx_root",
        "*.la",
        "*.a"
    ],
    "build-options" : {
        "env" : {
            "ONNX_ROOT" : "/app/onnx_root"
        }
    },
    "modules" : [
        {
            "name" : "onnxruntime",
            "buildsystem" : "simple",
            "sources" : [
                {
                    "type" : "archive",
                    "only-arches" : ["x86_64"],
                    "dest" : "onnxruntime-1",
                    "url" : "https://github.com/microsoft/onnxruntime/releases/download/v1.28.0/onnxruntime-linux-x64-1.28.0.tgz",
                    "sha256" : "a3e1b79d7bb1bf09696ce675f49e4064e6c81f6202b8225624fff0e93f8d6407"
                },

                {
                    "type" : "archive",
                    "only-arches" : ["aarch64"],
                    "dest" : "onnxruntime-1",
                    "url" : "https://github.com/microsoft/onnxruntime/releases/download/v1.28.0/onnxruntime-linux-aarch64-1.28.0.tgz",
                    "sha256" : "e15ff8b5d85afe6c144d97c6fd432254bf76a219daaf17658087d6ecb3e8f0bb"
                }
            ],
            "build-commands" : [
                "mkdir -p $ONNX_ROOT",
                "mv onnxruntime-1/* $ONNX_ROOT",

                "mkdir -p $FLATPAK_DEST/lib",
                "cp $ONNX_ROOT/lib/libonnxruntime*.so* $FLATPAK_DEST/lib"
            ]
        },

        {
            "name": "aprilmodel",
            "buildsystem" : "simple",
            "sources" : [
                {
                    "type" : "file",
                    "dest-filename" : "aprilv0_en-us.april",
                    "url" : "https://april.sapples.net/april-english-dev-01110_en.april",
                    "sha256" : "77eb95d0fa4f7708a37e868c2265301ee6c42dcb25e63ca63eea3d9cbadbc1f3"
                }
            ],
            "build-commands" : [
                "install -Dm644 aprilv0_en-us.april -t ${FLATPAK_DEST}/LiveCaptions/models"
            ]
        },

        {
            "name" : "livecaptions",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/abb128/LiveCaptions",
                    "branch" : "main"
                }
            ]
        }
    ]
}
