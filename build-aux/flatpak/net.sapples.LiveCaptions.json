{
    "app-id" : "net.sapples.LiveCaptions",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "livecaptions",
    "finish-args" : [
        "--share=ipc",
        "--device=dri",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--socket=fallback-x11"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "/onnx_root",
        "*.la",
        "*.a"
    ],
    "build-options" : {
        "env" : {
            "ONNX_ROOT" : "/app/onnx_root"
        }
    },
    "modules" : [
        {
            "name" : "onnxruntime",
            "buildsystem" : "simple",
            "sources" : [
                {
                    "type" : "archive",
                    "only-arches" : ["x86_64"],
                    "dest" : "onnxruntime-1",
                    "url" : "https://github.com/microsoft/onnxruntime/releases/download/v1.30.0/onnxruntime-linux-x64-1.30.0.tgz",
                    "sha256" : "a5ed5a3cac51fbb2e90da632ae43d19212faaa20e76484e62bcb7c23ddb3b3fd"
                },

                {
                    "type" : "archive",
                    "only-arches" : ["aarch64"],
                    "dest" : "onnxruntime-1",
                    "url" : "https://github.com/microsoft/onnxruntime/releases/download/v1.30.0/onnxruntime-linux-aarch64-1.30.0.tgz",
                    "sha256" : "e16a27a8ed330bbc698df7330b0cf56e722f354e3bcc92118682c74ef3c3e3da"
                }
            ],
            "build-commands" : [
                "mkdir -p $ONNX_ROOT",
                "mv onnxruntime-1/* $ONNX_ROOT",

                "mkdir -p $FLATPAK_DEST/lib",
                "cp $ONNX_ROOT/lib/libonnxruntime*.so* $FLATPAK_DEST/lib"
            ]
        },

        {
            "name": "aprilmodel",
            "buildsystem" : "simple",
            "sources" : [
                {
                    "type" : "file",
                    "dest-filename" : "aprilv0_en-us.april",
                    "url" : "https://april.sapples.net/april-english-dev-01110_en.april",
                    "sha256" : "77eb95d0fa4f7708a37e868c2265301ee6c42dcb25e63ca63eea3d9cbadbc1f3"
                }
            ],
            "build-commands" : [
                "install -Dm644 aprilv0_en-us.april -t ${FLATPAK_DEST}/LiveCaptions/models"
            ]
        },

        {
            "name": "silero-vad-model",
            "buildsystem" : "simple",
            "sources" : [
                {
                    "type" : "file",
                    "dest-filename" : "silero_vad_v5.onnx",
                    "url" : "https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/silero_vad_v5.onnx",
                    "sha256" : "6b99cbfd39246b6706f98ec13c7c50c6b299181f2474fa05cbc8046acc274396"
                }
            ],
            "build-commands" : [
                "install -Dm644 silero_vad_v5.onnx -t ${FLATPAK_DEST}/LiveCaptions/models"
            ]
        },

        {
            "name": "speaker-embedding-model",
            "buildsystem" : "simple",
            "sources" : [
                {
                    "type" : "file",
                    "dest-filename" : "wespeaker_en_voxceleb_CAMPP_LM.onnx",
                    "url" : "https://github.com/k2-fsa/sherpa-onnx/releases/download/speaker-recongition-models/wespeaker_en_voxceleb_CAM%2B%2B_LM.onnx",
                    "sha256" : "e197af7e9d473030cf486b3124149a19bf37014d0e4485e4c70c483b0ec10cb2"
                }
            ],
            "build-commands" : [
                "install -Dm644 wespeaker_en_voxceleb_CAMPP_LM.onnx -t ${FLATPAK_DEST}/LiveCaptions/models"
            ]
        },

        {
            "name" : "livecaptions",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/abb128/LiveCaptions",
                    "branch" : "main"
                }
            ]
        }
    ]
}
